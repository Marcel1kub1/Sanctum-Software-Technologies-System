<header class="header">
  <div class="header-left">
    <button class="sidebar-toggle" onclick="toggleSidebar()">☰</button>
    <div class="brand">
      <span class="brand-icon">⬡</span>
      <span class="brand-name">SANCTUM</span>
      <span class="brand-badge">DASHBOARD</span>
    </div>
  </div>
  <div class="header-right">
    <% if (selectedGuild) { %>
    <div class="header-status">
      <span class="status-dot"></span>
      <span><%= selectedGuild.name %></span>
      <span style="color:var(--text-muted);">·</span>
      <span style="color:var(--text-muted);"><%= selectedGuild.memberCount %> members</span>
      <span style="color:var(--text-muted);">·</span>
      <span style="color:var(--text-muted);"><%= stats.ping || 0 %>ms</span>
    </div>
    <% } else { %>
    <div class="header-status">
      <span class="status-dot"></span>
      <span><%= stats.guilds %> servers</span>
    </div>
    <% } %>
    <div class="header-user">
      <% if (user) { %>
        <img class="user-avatar" src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="avatar">
        <span class="user-name"><%= user.username %></span>
        <a href="/logout" class="btn-logout">Logout</a>
      <% } %>
    </div>
  </div>
</header>
