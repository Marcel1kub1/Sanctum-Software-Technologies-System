<div class="page-header">
  <h1 class="page-title">Auto Dehoist</h1>
  <p class="page-desc">Automatically fix name hoisting in the member list</p>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <div class="card-title">Auto Dehoist Module</div>
      <div class="card-desc">Enable or disable auto-dehoisting</div>
    </div>
    <label class="toggle">
      <input type="checkbox">
      <span class="toggle-slider"></span>
    </label>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header">
      <span class="card-title">Dehoist Settings</span>
    </div>
    <div class="form-group">
      <label class="form-label">Characters to Strip</label>
      <input class="form-input" value="!@#$%^&*()_-+=[]{}|;:',.<>?/~`">
      <div class="form-hint">Characters at the start of a username that trigger a rename</div>
    </div>
    <div class="form-group">
      <label class="form-label">Replacement Character</label>
      <input class="form-input" value="•" maxlength="1">
      <div class="form-hint">Character to replace hoisting characters with</div>
    </div>
    <div class="setting-row">
      <div><div class="setting-label">Notify on Rename</div><div class="setting-desc">Send a DM to users who get renamed</div></div>
      <label class="toggle"><input type="checkbox"><span class="toggle-slider"></span></label>
    </div>
    <div class="setting-row">
      <div><div class="setting-label">Log Renames</div><div class="setting-desc">Log all dehoist renames to mod logs</div></div>
      <label class="toggle"><input type="checkbox" checked><span class="toggle-slider"></span></label>
    </div>
  </div>
  <div class="card">
    <div class="card-header">
      <span class="card-title">Exemptions</span>
    </div>
    <div class="form-group">
      <label class="form-label">Exempt Roles</label>
      <input class="form-input" placeholder="@Admin @Staff @Moderator">
      <div class="form-hint">Roles that are not affected by dehoisting</div>
    </div>
    <div class="setting-row">
      <div><div class="setting-label">Exempt Bots</div><div class="setting-desc">Bots will not be renamed</div></div>
      <label class="toggle"><input type="checkbox" checked><span class="toggle-slider"></span></label>
    </div>
    <div class="setting-row">
      <div><div class="setting-label">Exempt Server Owner</div><div class="setting-desc">Server owner will not be renamed</div></div>
      <label class="toggle"><input type="checkbox" checked><span class="toggle-slider"></span></label>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <span class="card-title">Preview</span>
  </div>
  <div style="padding:12px; background:var(--bg-input); border-radius:8px; font-family:monospace; font-size:13px;">
    <div style="color:var(--red);">!!!BadUser → •••BadUser</div>
    <div style="color:var(--yellow); margin-top:4px;">$$$CoolKid → •••CoolKid</div>
    <div style="color:var(--green); margin-top:4px;">@@@Admin → •••Admin</div>
  </div>
  <div class="form-hint" style="margin-top:8px;">Usernames starting with special characters will have them replaced</div>
</div>

<div class="flex gap-2">
  <button class="btn btn-primary">Save Changes</button>
  <button class="btn btn-outline">Reset to Default</button>
</div>
