<div class="server-header">
  <div class="server-header-left">
    <div class="server-icon">
      <%= selectedGuild ? selectedGuild.name.charAt(0).toUpperCase() : 'S' %>
    </div>
    <div class="server-info">
      <div class="server-name"><%= selectedGuild ? selectedGuild.name : 'No Server Selected' %></div>
      <div class="server-stats">
        <span><%= selectedGuild ? selectedGuild.memberCount : 0 %> members</span>
        <span>·</span>
        <span>ID: <%= selectedGuild ? selectedGuild.id : '—' %></span>
      </div>
    </div>
  </div>
  <div class="server-header-right">
    <div class="stat-pill">
      <span class="pill-dot green"></span>
      <span>Online</span>
    </div>
    <div class="stat-pill">
      <span class="value"><%= Math.floor((stats.uptime || 0) / 86400) %>d</span>
      <span>uptime</span>
    </div>
    <div class="stat-pill">
      <span class="value"><%= stats.ping || 0 %>ms</span>
      <span>latency</span>
    </div>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-card-icon">👥</div>
    <div class="stat-card-value" style="color:var(--accent);" id="guildMemberCount"><%= selectedGuild ? selectedGuild.memberCount : 0 %></div>
    <div class="stat-card-label">Total Members</div>
    <div class="stat-card-change up" id="guildMemberChange">—</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-icon">🎫</div>
    <div class="stat-card-value" style="color:var(--green);" id="openTicketCount">0</div>
    <div class="stat-card-label">Open Tickets</div>
    <div class="stat-card-change" id="ticketChange">No active tickets</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-icon">🛡</div>
    <div class="stat-card-value" style="color:var(--yellow);" id="modActionCount">0</div>
    <div class="stat-card-label">Mod Actions</div>
    <div class="stat-card-change up" id="modActionChange">—</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-icon">📈</div>
    <div class="stat-card-value" style="color:var(--orange);" id="leveledUserCount">0</div>
    <div class="stat-card-label">Leveled Users</div>
    <div class="stat-card-change" id="levelUpChange">—</div>
  </div>
</div>

<div class="chart-container">
  <div class="chart-header">
    <span class="chart-title">7-Day Activity</span>
    <div class="chart-legend">
      <div class="chart-legend-item">
        <span class="chart-legend-dot" style="background:var(--accent);"></span>
        <span>Mod Actions</span>
      </div>
      <div class="chart-legend-item">
        <span class="chart-legend-dot" style="background:var(--green);"></span>
        <span>Tickets</span>
      </div>
    </div>
  </div>
  <div class="chart-bars" id="activityChartBars">
    <div class="empty-state" style="grid-column:1/-1;padding:20px;">
      <div class="empty-state-text">Loading activity data...</div>
    </div>
  </div>
</div>

<script>
async function loadActivityData() {
  const guildId = '<%= selectedGuild ? selectedGuild.id : '' %>';
  if (!guildId) return;

  try {
    const [activityRes, statsRes] = await Promise.all([
      fetch('/api/activity/' + guildId),
      fetch('/api/guild/stats/' + guildId)
    ]);

    const activity = await activityRes.json();
    const stats = await statsRes.json();

    document.getElementById('guildMemberCount').textContent = stats.memberCount || 0;
    document.getElementById('openTicketCount').textContent = stats.openTickets || 0;
    document.getElementById('modActionCount').textContent = stats.modActionsThisWeek || 0;
    document.getElementById('modActionChange').textContent = (stats.modActionsThisWeek || 0) + ' this week';
    document.getElementById('ticketChange').textContent = (stats.openTickets || 0) > 0 ? (stats.openTickets + ' open') : 'No active tickets';

    const container = document.getElementById('activityChartBars');
    const maxVal = Math.max(1, activity.maxVal || 1);
    const dayOrder = [1,2,3,4,5,6,0];
    const dayLabels = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];

    container.innerHTML = dayOrder.map(i => `
      <div class="chart-bar-group">
        <div class="chart-bar-wrapper">
          <div class="chart-bar blue" style="height:${Math.round((activity.modActions[i]/maxVal)*140)}px;" title="${activity.modActions[i]} mod actions"></div>
          <div class="chart-bar green" style="height:${Math.round((activity.tickets[i]/maxVal)*140)}px;" title="${activity.tickets[i]} tickets"></div>
        </div>
        <div class="chart-bar-label">${dayLabels[i]}</div>
      </div>
    `).join('');
  } catch (e) {
    console.error('Failed to load activity:', e);
  }
}

document.addEventListener('DOMContentLoaded', () => {
  loadActivityData();
  setInterval(loadActivityData, 15000);
});
</script>

