<div class="page-header">
  <h1 class="page-title">Auto Responder</h1>
  <p class="page-desc">Automated replies to specific keywords and phrases</p>
</div>

<form method="POST" action="/dashboard/config?guild=<%= selectedGuild ? selectedGuild.id : '' %>">

<div class="card">
  <div class="card-header">
    <div>
      <div class="card-title">Auto Responder Module</div>
      <div class="card-desc">Enable or disable the auto responder system</div>
    </div>
    <label class="toggle">
      <input type="checkbox" name="autoresponder_enabled" <%= gc('autoresponder_enabled', false) ? 'checked' : '' %>>
      <span class="toggle-slider"></span>
    </label>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <span class="card-title">Auto Responses</span>
      <div class="card-desc">Manage keyword-triggered automatic replies</div>
    </div>
    <button class="btn btn-primary btn-sm">+ Add Response</button>
  </div>
  <div class="empty-state" style="padding:20px;">
    <div class="empty-state-icon">🤖</div>
    <div class="empty-state-text">No auto responses configured</div>
    <p style="font-size:12px;color:var(--text-muted);margin-top:4px;">Add keyword-triggered responses for your community.</p>
  </div>
  <div style="margin-top:16px;">
    <div class="form-group">
      <label class="form-label">Example Auto Response</label>
      <div class="card" style="padding:16px;">
        <div class="grid-2">
          <div class="form-group">
            <label class="form-label">Trigger Keywords</label>
            <input class="form-input" name="autoresponder_trigger_keywords" value="<%= gc('autoresponder_trigger_keywords', 'hello, hi, hey') %>" placeholder="Comma-separated keywords">
          </div>
          <div class="form-group">
            <label class="form-label">Response Type</label>
            <select class="form-select" name="autoresponder_response_type">
              <option value="text" <%= gc('autoresponder_response_type', 'text') === 'text' ? 'selected' : '' %>>Text Message</option>
              <option value="embed" <%= gc('autoresponder_response_type', 'text') === 'embed' ? 'selected' : '' %>>Embed Message</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Response</label>
          <textarea class="form-textarea" name="autoresponder_response" rows="2"><%= gc('autoresponder_response', 'Hello there! Welcome to the server!') %></textarea>
        </div>
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <label class="toggle"><input type="checkbox" name="autoresponder_example_enabled" <%= gc('autoresponder_example_enabled', false) ? 'checked' : '' %>><span class="toggle-slider"></span></label>
            <span style="font-size:12px;color:var(--text-muted);">Enabled</span>
          </div>
          <button class="btn btn-outline btn-sm">Delete</button>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <span class="card-title">Responder Settings</span>
  </div>
  <div class="setting-row">
    <div><div class="setting-label">Ignore Bots</div><div class="setting-desc">Don't respond to bot messages</div></div>
    <label class="toggle"><input type="checkbox" name="autoresponder_ignore_bots" <%= gc('autoresponder_ignore_bots', true) ? 'checked' : '' %>><span class="toggle-slider"></span></label>
  </div>
  <div class="setting-row">
    <div><div class="setting-label">Match Case</div><div class="setting-desc">Keywords are case-sensitive</div></div>
    <label class="toggle"><input type="checkbox" name="autoresponder_match_case" <%= gc('autoresponder_match_case', false) ? 'checked' : '' %>><span class="toggle-slider"></span></label>
  </div>
  <div class="setting-row">
    <div><div class="setting-label">Respond in Same Channel</div><div class="setting-desc">Always respond in the same channel as the trigger</div></div>
    <label class="toggle"><input type="checkbox" name="autoresponder_respond_same_channel" <%= gc('autoresponder_respond_same_channel', true) ? 'checked' : '' %>><span class="toggle-slider"></span></label>
  </div>
</div>

<div class="flex gap-2">
  <button class="btn btn-primary">Save Changes</button>
  <button class="btn btn-outline">Reset to Default</button>
</div>

</form>