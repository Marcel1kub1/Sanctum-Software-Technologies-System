<div class="page-header">
  <h1 class="page-title">Role / Channel / Voice Moderation</h1>
  <p class="page-desc">Manage role assignments, channel lockdowns, and voice controls</p>
</div>

<form method="POST" action="/dashboard/config?guild=<%= selectedGuild ? selectedGuild.id : '' %>">

<div class="card">
  <div class="card-header">
    <div>
      <div class="card-title">Role/Channel/Voice Module</div>
      <div class="card-desc">Enable or disable advanced moderation controls</div>
    </div>
    <label class="toggle">
      <input type="checkbox" name="rolechannelvoice_enabled" <%= gc('rolechannelvoice_enabled', false) ? 'checked' : '' %>>
      <span class="toggle-slider"></span>
    </label>
  </div>
</div>

<div class="grid-3">
  <div class="card">
    <div class="card-header">
      <span class="card-title">Role Moderation</span>
    </div>
    <div class="setting-row">
      <div><div class="setting-label">Unauthorized Role Prevention</div><div class="setting-desc">Block non-admin role assignments</div></div>
      <label class="toggle"><input type="checkbox" name="rolechannelvoice_unauthorized_role_prevention" <%= gc('rolechannelvoice_unauthorized_role_prevention', true) ? 'checked' : '' %>><span class="toggle-slider"></span></label>
    </div>
    <div class="setting-row">
      <div><div class="setting-label">Auto-Role Removal</div><div class="setting-desc">Remove roles automatically on certain events</div></div>
      <label class="toggle"><input type="checkbox" name="rolechannelvoice_auto_role_removal" <%= gc('rolechannelvoice_auto_role_removal', false) ? 'checked' : '' %>><span class="toggle-slider"></span></label>
    </div>
    <div class="form-group">
      <label class="form-label">Role Blacklist</label>
      <input class="form-input" name="rolechannelvoice_role_blacklist" value="<%= gc('rolechannelvoice_role_blacklist', '') %>" placeholder="@Admin @Owner">
      <div class="form-hint">Roles that cannot be self-assigned</div>
    </div>
  </div>
  <div class="card">
    <div class="card-header">
      <span class="card-title">Channel Moderation</span>
    </div>
    <div class="setting-row">
      <div><div class="setting-label">Channel Lockdown</div><div class="setting-desc">Quickly lock channels during incidents</div></div>
      <label class="toggle"><input type="checkbox" name="rolechannelvoice_channel_lockdown" <%= gc('rolechannelvoice_channel_lockdown', true) ? 'checked' : '' %>><span class="toggle-slider"></span></label>
    </div>
    <div class="setting-row">
      <div><div class="setting-label">Slow Mode Control</div><div class="setting-desc">Enable slow mode override</div></div>
      <label class="toggle"><input type="checkbox" name="rolechannelvoice_slow_mode_control" <%= gc('rolechannelvoice_slow_mode_control', false) ? 'checked' : '' %>><span class="toggle-slider"></span></label>
    </div>
    <div class="setting-row">
      <div><div class="setting-label">Nuke Channel</div><div class="setting-desc">Allow channel cloning and deletion</div></div>
      <label class="toggle"><input type="checkbox" name="rolechannelvoice_nuke_channel" <%= gc('rolechannelvoice_nuke_channel', false) ? 'checked' : '' %>><span class="toggle-slider"></span></label>
    </div>
  </div>
  <div class="card">
    <div class="card-header">
      <span class="card-title">Voice Moderation</span>
    </div>
    <div class="setting-row">
      <div><div class="setting-label">Voice Mute</div><div class="setting-desc">Server mute members in voice</div></div>
      <label class="toggle"><input type="checkbox" name="rolechannelvoice_voice_mute" <%= gc('rolechannelvoice_voice_mute', true) ? 'checked' : '' %>><span class="toggle-slider"></span></label>
    </div>
    <div class="setting-row">
      <div><div class="setting-label">Voice Deafen</div><div class="setting-desc">Server deafen members in voice</div></div>
      <label class="toggle"><input type="checkbox" name="rolechannelvoice_voice_deafen" <%= gc('rolechannelvoice_voice_deafen', true) ? 'checked' : '' %>><span class="toggle-slider"></span></label>
    </div>
    <div class="setting-row">
      <div><div class="setting-label">Voice Kick</div><div class="setting-desc">Disconnect members from voice</div></div>
      <label class="toggle"><input type="checkbox" name="rolechannelvoice_voice_kick" <%= gc('rolechannelvoice_voice_kick', true) ? 'checked' : '' %>><span class="toggle-slider"></span></label>
    </div>
    <div class="setting-row">
      <div><div class="setting-label">Voice Move</div><div class="setting-desc">Move members between channels</div></div>
      <label class="toggle"><input type="checkbox" name="rolechannelvoice_voice_move" <%= gc('rolechannelvoice_voice_move', true) ? 'checked' : '' %>><span class="toggle-slider"></span></label>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <span class="card-title">Permission Override Bypass</span>
      <div class="card-desc">Roles that can bypass role/channel/voice restrictions</div>
    </div>
    <button type="button" class="btn btn-primary btn-sm" onclick="addBypassRole()">+ Add Role</button>
  </div>
  <div class="empty-state" style="padding:16px;">
    <div class="empty-state-text" style="font-size:13px;">No bypass roles configured</div>
  </div>
</div>

<div class="flex gap-2">
  <button class="btn btn-primary">Save Changes</button>
  <button class="btn btn-outline">Reset to Default</button>
</div>
</form>

<script>
function addBypassRole() {
  const role = prompt('Enter role name or ID to add as bypass:');
  if (!role) return;
  const container = document.querySelector('.card .empty-state')?.parentElement;
  if (!container) return;
  const empty = container.querySelector('.empty-state');
  if (empty) empty.remove();
  const div = document.createElement('div');
  div.style.cssText = 'display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--bg-input);border:1px solid var(--border);border-radius:8px;margin-top:8px;font-size:13px;';
  div.innerHTML = '<span style="font-weight:600;">' + role + '</span><span style="margin-left:auto;color:var(--red);cursor:pointer;" onclick="this.parentElement.remove()">✕</span>';
  container.appendChild(div);
}
</script>
