        <option value="de" <%= gc('music_default_language', 'en') === 'de' ? 'selected' : '' %>>German</option>
        <option value="it" <%= gc('music_default_language', 'en') === 'it' ? 'selected' : '' %>>Italian</option>
        <option value="ru" <%= gc('music_default_language', 'en') === 'ru' ? 'selected' : '' %>>Russian</option>
