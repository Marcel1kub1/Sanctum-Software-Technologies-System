  <div class="card">
    <div class="card-header">
      <span class="card-title">Multi-Language</span>
    </div>
    <div class="form-group">
      <label class="form-label">Default Language</label>
      <select class="form-select" name="music_default_language">
        <option value="en" <%= gc('music_default_language', 'en') === 'en' ? 'selected' : '' %>>English</option>
        <option value="tr" <%= gc('music_default_language', 'en') === 'tr' ? 'selected' : '' %>>Turkish</option>
