    <div class="setting-row">
      <div><div class="setting-label">Vote Skip</div><div class="setting-desc">Skip requires votes instead of instant</div></div>
      <label class="toggle"><input type="checkbox" <%= gc('music_vote_skip', false) ? 'checked' : '' %> name="music_vote_skip"><span class="toggle-slider"></span></label>
    </div>
    <div class="setting-row">
      <div><div class="setting-label">Vote Percentage</div></div>
      <input class="form-input inline-input" type="number" value="<%= gc('music_vote_percentage', '50') %>" min="1" max="100" name="music_vote_percentage">
    </div>
    <div class="setting-row">
      <div><div class="setting-label">Allowed Voice Channels</div></div>
      <select class="form-select" style="width:160px;" name="music_allowed_voice_channels">
        <option value="" <%= gc('music_allowed_voice_channels', '') === '' ? 'selected' : '' %>>All channels</option>
        <% (selectedGuild.voiceChannels || []).forEach(vc => { %>
          <option value="<%= vc.id %>" <%= gc('music_allowed_voice_channels', '') === vc.id ? 'selected' : '' %>><%= vc.name %></option>
