  </div>
</div>

<div class="flex gap-2">
  <button class="btn btn-primary">Save Changes</button>
  <button class="btn btn-outline">Reset to Default</button>
</div>

</form>

<script>
function formatTime(ms) {
  if (!ms || ms < 0) return '0:00';
  const totalSec = Math.floor(ms / 1000);
  const min = Math.floor(totalSec / 60);
  const sec = totalSec % 60;
  return min + ':' + (sec < 10 ? '0' : '') + sec;
}

function formatUptime(ms) {
  if (!ms) return '—';
  const s = Math.floor(ms / 1000);
  const d = Math.floor(s / 86400);
  const h = Math.floor((s % 86400) / 3600);
  const m = Math.floor((s % 3600) / 60);
  let str = '';
  if (d > 0) str += d + 'd ';
  if (h > 0) str += h + 'h ';
  str += m + 'm';
  return str;
}

function formatBytes(n) {
  if (!n) return '0MB';
  const mb = n / 1024 / 1024;
  return mb.toFixed(0) + 'MB';
}

async function refreshMusicStatus() {
  const guildId = '<%= selectedGuild ? selectedGuild.id : '' %>';
  if (!guildId) return;

  try {
    const res = await fetch('/api/music/status?guild=' + guildId);
    const data = await res.json();

    // Lavalink Status card
    const statusBadge = document.getElementById('lavalinkStatusBadge');
    if (data.node && data.node.connected) {
      statusBadge.className = 'badge badge-green';
      statusBadge.textContent = '● Connected';
    } else {
      statusBadge.className = 'badge badge-red';
      statusBadge.textContent = '● Disconnected';
    }

    const playersEl = document.getElementById('lavalinkPlayers');
    if (data.node && data.node.connected) {
      playersEl.textContent = data.node.players + ' total, ' + data.node.playingPlayers + ' playing';
    } else {
      playersEl.textContent = '—';
    }

    const uptimeEl = document.getElementById('lavalinkUptime');
    uptimeEl.textContent = data.node && data.node.connected ? formatUptime(data.node.uptime) : '—';

    const cpuEl = document.getElementById('lavalinkCpu');
    cpuEl.textContent = data.node && data.node.connected ? (data.node.cpu * 100).toFixed(1) + '%' : '—';

    const memEl = document.getElementById('lavalinkMemory');
    if (data.node && data.node.connected) {
      memEl.textContent = formatBytes(data.node.memory.used) + ' / ' + formatBytes(data.node.memory.reserved);
    } else {
      memEl.textContent = '—';
    }

    // Now Playing panel
    const npBadge = document.getElementById('npStatusBadge');
    const npTitle = document.getElementById('npTitle');
    const npSubtitle = document.getElementById('npSubtitle');
    const npVolume = document.getElementById('npVolume');
    const npLoop = document.getElementById('npLoop');
    const npShuffle = document.getElementById('npShuffle');
    const npAutoplay = document.getElementById('npAutoplay');
    const npPosition = document.getElementById('npPosition');
    const npDuration = document.getElementById('npDuration');
    const npProgress = document.getElementById('npProgress');
    const npQueueSize = document.getElementById('npQueueSize');
    const npUpcoming = document.getElementById('npUpcoming');

    if (data.player && data.player.connected && data.player.current) {
      const t = data.player.current;
      npBadge.className = 'badge badge-green';
      npBadge.textContent = data.player.paused ? '⏸ Paused' : '▶ Playing';
      npTitle.textContent = t.title;
      npSubtitle.textContent = t.author + (t.uri ? ' · ' + t.uri : '');
      npVolume.textContent = 'Volume: ' + data.player.volume + '%';
      npLoop.textContent = 'Loop: ' + (data.player.loop || 'off');
      npShuffle.textContent = 'Shuffle: ' + (data.player.shuffled ? 'On' : 'Off');
      npAutoplay.textContent = 'Autoplay: ' + (data.player.autoplay ? 'On' : 'Off');

      const pos = data.player.position || 0;
      const dur = t.duration || 1;
      npPosition.textContent = formatTime(pos);
      npDuration.textContent = formatTime(dur);
      npProgress.style.width = Math.min(100, (pos / dur) * 100) + '%';

      npQueueSize.textContent = data.player.queueSize || 0;
    } else {
      npBadge.className = 'badge badge-yellow';
      npBadge.textContent = '● Idle';
      npTitle.textContent = 'No music playing';
      npSubtitle.textContent = 'Queue is empty — add songs with /play';
      npPosition.textContent = '0:00';
      npDuration.textContent = '0:00';
      npProgress.style.width = '0%';
      npQueueSize.textContent = '0';
    }

    // Queue card
    const queueSizeBadge = document.getElementById('queueSizeBadge');
    const queueContent = document.getElementById('queueContent');
    const queueSize = data.player ? (data.player.queueSize || 0) : 0;
    if (queueSize > 0) {
      queueSizeBadge.className = 'badge badge-green';
      queueSizeBadge.textContent = queueSize + ' tracks';
      npUpcoming.textContent = queueSize + ' track(s) in queue';
    } else {
      queueSizeBadge.className = 'badge badge-yellow';
      queueSizeBadge.textContent = 'Empty';
      npUpcoming.textContent = 'No upcoming tracks';
      queueContent.innerHTML = '<div class="empty-state" style="padding:16px;"><div class="empty-state-text" style="font-size:13px;">Queue is empty</div></div>';
    }
  } catch (e) {
    console.error('Music status poll error:', e);
  }
}

document.addEventListener('DOMContentLoaded', () => {
  refreshMusicStatus();
  setInterval(refreshMusicStatus, 5000);
});
</script>
