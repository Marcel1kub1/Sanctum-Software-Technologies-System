<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sanctum Technologies</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #08080e; --card: #10101a; --border: #1e1e30;
      --text: #eeeef8; --text-secondary: #8888aa; --accent: #ff0080;
      --green: #00ff88; --blue: #00ccff;
    }
    body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 20px; }
    .brand { font-size: 48px; font-weight: 900; letter-spacing: 3px; margin-bottom: 8px; }
    .brand span { background: linear-gradient(135deg, var(--accent), var(--blue)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .subtitle { font-size: 16px; color: var(--text-secondary); margin-bottom: 48px; letter-spacing: 1px; }
    .stats { display: flex; gap: 24px; margin-bottom: 48px; flex-wrap: wrap; justify-content: center; }
    .stat-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 24px 32px; text-align: center; min-width: 140px; transition: border-color 0.2s; }
    .stat-card:hover { border-color: var(--accent); }
    .stat-value { font-size: 32px; font-weight: 800; background: linear-gradient(135deg, var(--accent), var(--blue)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .stat-label { font-size: 13px; color: var(--text-secondary); margin-top: 4px; }
    .actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
    .btn { padding: 12px 24px; border-radius: 8px; font-size: 14px; font-weight: 600; text-decoration: none; transition: all 0.2s; font-family: inherit; }
    .btn-primary { background: linear-gradient(135deg, var(--accent), #cc0066); color: white; box-shadow: 0 0 16px rgba(255,0,128,0.25); }
    .btn-primary:hover { box-shadow: 0 0 24px rgba(255,0,128,0.4); transform: translateY(-1px); }
    .btn-outline { border: 1px solid var(--border); color: var(--text-secondary); }
    .btn-outline:hover { border-color: var(--accent); color: var(--accent); box-shadow: 0 0 12px rgba(255,0,128,0.15); }
    .footer { margin-top: 64px; font-size: 12px; color: var(--text-muted, #555570); }
  </style>
</head>
<body>
  <div class="brand">SANCTUM <span>TECHNOLOGIES</span></div>
  <div class="subtitle">Complete Discord Management Solution</div>
  <div class="stats">
    <div class="stat-card"><div class="stat-value"><%= stats.guilds %></div><div class="stat-label">Servers</div></div>
    <div class="stat-card"><div class="stat-value"><%= stats.users %></div><div class="stat-label">Users</div></div>
    <div class="stat-card"><div class="stat-value"><%= stats.commands %></div><div class="stat-label">Commands</div></div>
  </div>
  <div class="actions">
    <% if (user) { %>
      <a href="/dashboard" class="btn btn-primary">Dashboard</a>
      <a href="/logout" class="btn btn-outline">Logout</a>
    <% } else { %>
      <a href="/auth" class="btn btn-primary">Login with Discord</a>
    <% } %>
    <a href="<%= config.botInvite %>" target="_blank" class="btn btn-outline">Invite Bot</a>
    <a href="<%= config.supportServer %>" target="_blank" class="btn btn-outline">Support Server</a>
  </div>
  <div class="footer">Sanctum Technologies &copy; 2026</div>
</body>
</html>