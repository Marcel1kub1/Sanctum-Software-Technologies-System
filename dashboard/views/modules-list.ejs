<div class="page-header">
  <h1 class="page-title">Modules</h1>
  <p class="page-desc">Configure all bot modules and features</p>
</div>

<div style="display:flex; gap:12px; margin-bottom:24px; flex-wrap:wrap;">
  <input type="text" id="moduleSearch" placeholder="Search modules..." class="form-input" style="flex:1; min-width:200px;">
  <select id="categoryFilter" class="form-select" style="min-width:150px;">
    <option value="">All Categories</option>
    <option value="support">Support</option>
    <option value="engagement">Engagement</option>
    <option value="moderation">Moderation</option>
    <option value="entertainment">Entertainment</option>
    <option value="utility">Utility</option>
    <option value="community">Community</option>
  </select>
</div>

<div id="modulesList" class="modules-grid">
  <!-- Populated by JavaScript -->
</div>

<script>
  async function loadModules() {
    try {
      const res = await fetch('/api/modules');
      const modules = await res.json();
      renderModules(modules);
      setupFilters(modules);
    } catch (e) {
      console.error('Failed to load modules:', e);
    }
  }

  function renderModules(modules) {
    const container = document.getElementById('modulesList');
    container.innerHTML = modules.map(m => `
      <div class="module-card">
        <div class="module-card-top">
          <span class="module-card-icon">${m.icon || '⚙️'}</span>
          <span class="badge ${m.enabled ? 'badge-green' : 'badge-red'}">${m.enabled ? 'ENABLED' : 'DISABLED'}</span>
        </div>
        <div class="module-card-title">${m.name}</div>
        <div class="module-card-desc">${m.description}</div>
        <div class="module-card-actions">
          <span class="module-card-status ${m.enabled ? 'on' : 'off'}">${m.enabled ? '✓ Active' : '✗ Disabled'}</span>
          <a href="/dashboard?tab=module&module=${m.key}&guild=<%= selectedGuild ? selectedGuild.id : '' %>" class="btn-configure">Configure →</a>
        </div>
      </div>
    `).join('');
  }

  function setupFilters(modules) {
    const search = document.getElementById('moduleSearch');
    const categoryFilter = document.getElementById('categoryFilter');

    function applyFilters() {
      const searchTerm = search.value.toLowerCase();
      const category = categoryFilter.value;
      const cards = document.querySelectorAll('.module-card');
      
      cards.forEach(card => {
        const title = card.querySelector('.module-card-title').textContent.toLowerCase();
        const desc = card.querySelector('.module-card-desc').textContent.toLowerCase();
        const moduleCategory = modules.find(m => m.name === card.querySelector('.module-card-title').textContent)?.category;
        
        const matchesSearch = title.includes(searchTerm) || desc.includes(searchTerm);
        const matchesCategory = !category || moduleCategory === category;
        
        card.style.display = (matchesSearch && matchesCategory) ? '' : 'none';
      });
    }

    search.addEventListener('input', applyFilters);
    categoryFilter.addEventListener('change', applyFilters);
  }

  loadModules();
</script>

<style>
  #moduleSearch, #categoryFilter { 
    font-size: 13px; 
    padding: 9px 12px;
  }
  
  .modules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .module-card {
    background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(0,0,0,0.02));
    border: 1px solid rgba(255,255,255,0.02);
    border-radius: 12px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
  }

  .module-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(255,42,166,0.1);
  }

  .module-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  .module-card-icon {
    font-size: 28px;
  }

  .module-card-title {
    font-size: 15px;
    font-weight: 700;
    margin-top: 4px;
    color: var(--text-primary);
  }

  .module-card-desc {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.4;
    margin-top: 4px;
    flex: 1;
  }

  .module-card-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid rgba(255,255,255,0.02);
  }

  .module-card-status {
    font-size: 11px;
    font-weight: 600;
  }

  .module-card-status.on {
    color: var(--green);
    text-shadow: 0 0 8px var(--green-glow);
  }

  .module-card-status.off {
    color: var(--text-muted);
  }

  .btn-configure {
    font-size: 12px;
    color: var(--blue);
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid rgba(109,211,255,0.3);
    transition: 0.2s;
    text-decoration: none;
  }

  .btn-configure:hover {
    background: var(--blue-subtle);
    border-color: var(--blue);
    box-shadow: 0 0 8px var(--blue-glow);
  }
</style>
