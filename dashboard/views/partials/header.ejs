<header class="header">
  <div class="header-left">
    <button class="sidebar-toggle" onclick="toggleSidebar()">☰</button>
    <div class="brand">
      <span class="brand-icon">⬡</span>
      <span class="brand-name">SANCTUM</span>
      <span class="brand-badge">DASHBOARD</span>
    </div>
  </div>
  <div class="header-stats">
    <div class="header-stat">
      <span class="stat-icon">🖥</span>
      <span class="stat-value"><%= stats.guilds || 0 %></span>
      <span>servers</span>
    </div>
    <div class="header-stat">
      <span class="stat-icon">👥</span>
      <span class="stat-value"><%= stats.users || 0 %></span>
      <span>users</span>
    </div>
    <div class="header-stat">
      <span class="stat-icon">⚡</span>
      <span class="stat-value"><%= stats.ping || 0 %>ms</span>
      <span>latency</span>
    </div>
    <div class="header-stat">
      <span class="stat-dot green"></span>
      <span class="stat-value"><%= Math.floor((stats.uptime || 0) / 86400) %>d</span>
      <span>uptime</span>
    </div>
  </div>
  <div class="header-right">
    <% if (selectedGuild) { %>
    <div class="header-stat" style="border-color:var(--accent);">
      <span class="status-dot green"></span>
      <span><%= selectedGuild.name %></span>
    </div>
    <% } %>
    <div class="header-user">
      <% if (user) { %>
        <img class="user-avatar" src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="avatar">
        <span class="user-name"><%= user.username %></span>
        <a href="/logout" class="btn-logout">Logout</a>
      <% } %>
    </div>
  </div>
</header>